include("./build/cmake/3rdlibs/dlib/u3-dlib-lib-values.cmake")

set(U3_3RDLIB_NAME_DLIB_UTIL ${U3_3RDLIB_NAME_DLIB}-util)

u3_project_add(
    PROJECT_NAME ${U3_3RDLIB_NAME_DLIB_UTIL}
    PROJECT_VERSION "v${U3_3RDLIB_VER_DLIB}"
    BIN_URL ${U3_3RDLIB_ESRC_URL_DLIB_BIN}
    NAME_BIN_MD5 U3_3RDLIB_DLIB${U3_3RDLIB_VER_DLIB_CID}_MD5_${U3_ENV_GEN_3RDLIB_POSTFIX}
    BIN_MD5 ${U3_3RDLIB_DLIB${U3_3RDLIB_VER_DLIB_CID}_MD5_${U3_ENV_GEN_3RDLIB_POSTFIX}}
    SRC_URL ${U3_3RDLIB_OSRC_URL_DLIB}
    SRC_MD5 ${U3_3RDLIB_DLIB_MD5}
    ESRC_URL ${U3_3RDLIB_ESRC_URL_DLIB_SRC}
    ESRC_MD5 ${U3_3RDLIB_DLIB_MD5}
    PATCH_CMD ""
    INSTALL_COMMAND "echo"
    USE_HTTP_FOR_ESRC FALSE
    BUILD_IN_SOURCE FALSE
    IT_CMAKE_PROJECT TRUE
    FORCE_COMPILE FALSE
    FORCE_SKIP_COMPILE ${U3_DETECT_CROSS_COMPILE}
    EXT_CMAKE_ARGS
    -DDLIB_NO_GUI_SUPPORT=ON
    -DDLIB_USE_BLAS=OFF
    -DDLIB_USE_LAPACK=OFF
    -DDLIB_USE_CUDA=OFF
    -DDLIB_PNG_SUPPORT=OFF
    -DDLIB_GIF_SUPPORT=OFF
    -DDLIB_JPEG_SUPPORT=OFF
    -DDLIB_WEBP_SUPPORT=OFF
    -DDLIB_JXL_SUPPORT=OFF
    -DDLIB_LINK_WITH_SQLITE3=OFF
    -DDLIB_USE_FFTW=OFF
    -DDLIB_USE_MKL_FFT=OFF
    -DDLIB_USE_FFMPEG=OFF
)

#-DDLIB_USE_CUDA=OFF
#cmake .. -DCMAKE_TOOLCHAIN_FILE=../toolchain.cmake -DUSE_NEON_INSTRUCTIONS=ON -DCMAKE_CXX_FLAGS="-mfpu=neon -O3"
#DLIB_NO_GUI_SUPPORT_STR

#message(FATAL_ERROR "U3_DETECT_CROSS_COMPILE=${U3_DETECT_CROSS_COMPILE}")
#message(FATAL_ERROR "U3_GVXX_PROJECT_ADD_SOURCE_TYPE=${U3_GVXX_PROJECT_ADD_SOURCE_TYPE}")

if (U3_GVXX_PROJECT_ADD_SOURCE_TYPE STREQUAL "U3_ADD_PROJECT_RESULT_SKIP_COMPILE")
  set(U3_EXTLIB_DLIB_FORCE_SKIP_USE TRUE)
  set(U3_SHARED_COMPILE_DEF_CPP ${U3_SHARED_COMPILE_DEF_CPP} -DU3_EXTLIB_DLIB_FORCE_SKIP_USE=${U3_EXTLIB_DLIB_FORCE_SKIP_USE})
  return()
endif ()

ExternalProject_Get_Property(${U3_3RDLIB_NAME_DLIB_UTIL} install_dir)

set(U3_INCLUDE_DIR_EXTLIB_DLIB "${install_dir}/src/dlib-util")
set(U3_INSTALL_DIR_EXTLIB_DLIB "${install_dir}/src/dlib-util/${U3_3RDLIB_DLIB_FILE_NAME}")

if (NOT U3_GVXX_PROJECT_ADD_SOURCE_TYPE STREQUAL "U3_ADD_PROJECT_RESULT_BIN")

  if (U3_PLATFORM_NAME STREQUAL U3_PLATFORM_NAME_WINDOWS OR
      CMAKE_GENERATOR STREQUAL "Xcode")
    set(U3_ADD2PATH_EXTLIB_DLIB "${CMAKE_BUILD_TYPE}/")
  else ()
    set(U3_ADD2PATH_EXTLIB_DLIB "")
  endif ()

  set(U3_INSTALL_DIR_EXTLIB_DLIB "${install_dir}/src/dlib-util-build/dlib/${U3_ADD2PATH_EXTLIB_DLIB}${U3_3RDLIB_DLIB_FILE_NAME}")
  set(U3_BIN_TEMP_FOLDER_EXTLIB_DLIB "${install_dir}/~temp-dlib-util")

  add_custom_command(
      TARGET ${U3_3RDLIB_NAME_DLIB_UTIL}
      POST_BUILD
      # fix error: unresolved external symbol _USER_ERROR__inconsistent_build_configuration__see_dlib_faq_2
      COMMAND
      ${CMAKE_COMMAND} -E copy_if_different ${install_dir}/src/dlib-util-build/dlib/config.h ${U3_INCLUDE_DIR_EXTLIB_DLIB}/dlib/config.h
      COMMAND
      ${CMAKE_COMMAND} -E rm -Rf "${U3_BIN_TEMP_FOLDER_EXTLIB_DLIB}"
      COMMAND
      ${CMAKE_COMMAND} -E make_directory "${U3_BIN_TEMP_FOLDER_EXTLIB_DLIB}"
      COMMAND
      ${CMAKE_COMMAND} -E copy "${install_dir}/src/dlib-util-build/dlib/*.a" "${U3_BIN_TEMP_FOLDER_EXTLIB_DLIB}"
      COMMAND
      ${CMAKE_COMMAND} -E copy "${install_dir}/src/dlib-util-build/dlib/revision.h" "${U3_BIN_TEMP_FOLDER_EXTLIB_DLIB}"
      COMMAND
      ${CMAKE_COMMAND} -E copy_directory_if_different "${install_dir}/src/dlib-util/dlib/" "${U3_BIN_TEMP_FOLDER_EXTLIB_DLIB}/dlib/"
      COMMAND
      ${CMAKE_COMMAND} -E chdir "${U3_BIN_TEMP_FOLDER_EXTLIB_DLIB}" tar czvf "${install_dir}/../${U3_3RDLIB_NAME_DLIB_BIN}" "./")

endif ()

u3_make_fake_file(FILE_NAME ${U3_INSTALL_DIR_EXTLIB_DLIB} CONTENT "dlib")

add_library(dlib-lib STATIC IMPORTED)
set_target_properties(dlib-lib PROPERTIES IMPORTED_LOCATION ${U3_INSTALL_DIR_EXTLIB_DLIB})
#add_dependencies( dlib-lib ${U3_3RDLIB_NAME_DLIB_UTIL} )

set(U3_DEPENDENCY_TARGETS_LIST ${U3_DEPENDENCY_TARGETS_LIST} ${U3_3RDLIB_NAME_DLIB_UTIL})
