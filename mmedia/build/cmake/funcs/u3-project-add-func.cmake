function(u3_project_add)
  cmake_parse_arguments(
      U3_GVXX_PROJECT_ADD ""
      "EXT_CMAKE_ARGS;USE_HTTP_FOR_ESRC;PROJECT_NAME;PROJECT_VERSION;BIN_URL;NAME_BIN_MD5;BIN_MD5;SRC_URL;SRC_MD5;ESRC_URL;ESRC_MD5;BUILD_IN_SOURCE;IT_CMAKE_PROJECT;FORCE_COMPILE"
      "PATCH_CMD" ${ARGN})

  message(STATUS "****** add external project")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_PROJECT_NAME=${U3_GVXX_PROJECT_ADD_PROJECT_NAME}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_PROJECT_VERSION=${U3_GVXX_PROJECT_ADD_PROJECT_VERSION}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_NAME_BIN_MD5=${U3_GVXX_PROJECT_ADD_NAME_BIN_MD5}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_BIN_MD5=${U3_GVXX_PROJECT_ADD_BIN_MD5}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_SRC_URL=${U3_GVXX_PROJECT_ADD_SRC_URL}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_ESRC_URL=${U3_GVXX_PROJECT_ADD_ESRC_URL}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_ESRC_MD5=${U3_GVXX_PROJECT_ADD_ESRC_MD5}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_BIN_URL=${U3_GVXX_PROJECT_ADD_BIN_URL}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_PATCH_CMD=${U3_GVXX_PROJECT_ADD_PATCH_CMD}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_FORCE_COMPILE=${U3_GVXX_PROJECT_ADD_FORCE_COMPILE}")
  message(STATUS "*** U3_GVXX_PROJECT_ADD_USE_HTTP_FOR_ESRC=${U3_GVXX_PROJECT_ADD_USE_HTTP_FOR_ESRC}")
  message(STATUS "******")

  if (NOT DEFINED U3_GVXX_PROJECT_ADD_PROJECT_NAME OR
      NOT DEFINED U3_GVXX_PROJECT_ADD_SRC_URL OR
      NOT DEFINED U3_GVXX_PROJECT_ADD_ESRC_URL OR
      NOT DEFINED U3_GVXX_PROJECT_ADD_ESRC_MD5)
    message(FATAL_ERROR "values not defined")
  endif ()

  set(U3_FUNC_RESULT FALSE)
  set(U3_GVXX_PROJECT_ADD_SOURCE_TYPE "")

  # load prebuild artifacts
  if (NOT U3_FORCE_RECOMPILE_3RDLIBS AND NOT U3_GVXX_PROJECT_ADD_FORCE_COMPILE)
    u3_validate_url(URL ${U3_GVXX_PROJECT_ADD_BIN_URL})
    #message(AUTHOR_WARNING "u3_project_add:---->U3_GVXX_PROJECT_ADD_BIN_URL=${U3_GVXX_PROJECT_ADD_BIN_URL} U3_FUNC_RESULT=${U3_FUNC_RESULT}")
    if (U3_FUNC_RESULT)
      ExternalProject_Add(
          ${U3_GVXX_PROJECT_ADD_PROJECT_NAME}
          URL ${U3_GVXX_PROJECT_ADD_BIN_URL}
          PREFIX "${U3_ENV_GEN_3RDLIB_FOLDERS}/${U3_GVXX_PROJECT_ADD_PROJECT_NAME}"
          DOWNLOAD_DIR "${U3_ENV_GEN_3RDLIB_FOLDERS_DOWNLOADS}"
          DOWNLOAD_NO_PROGRESS FALSE
          URL_HASH MD5=${U3_GVXX_PROJECT_ADD_BIN_MD5}
          DOWNLOAD_EXTRACT_TIMESTAMP FALSE
          TIMEOUT 1200
          PATCH_COMMAND ""
          CONFIGURE_COMMAND ""
          BUILD_COMMAND ""
          INSTALL_COMMAND ""
          CMAKE_ARGS ${U3_GVXX_PROJECT_ADD_EXT_CMAKE_ARGS})

      set(U3_GVXX_PROJECT_ADD_SOURCE_TYPE "U3_ADD_PROJECT_RESULT_BIN")
    endif ()
  endif ()

  if (NOT U3_FUNC_RESULT)
    if (U3_GVXX_PROJECT_ADD_IT_CMAKE_PROJECT)
      u3_project_add_cmake()
    else ()
      u3_project_add_not_cmake()
    endif ()

    if (U3_DBG_STOP_BEFORE_COMPILE_EXTLIBS)
      message(AUTHOR_WARNING "U3_GVXX_PROJECT_ADD_NAME_BIN_MD5=${U3_GVXX_PROJECT_ADD_NAME_BIN_MD5}")
      message(AUTHOR_WARNING "U3_GVXX_PROJECT_ADD_BIN_MD5=${U3_GVXX_PROJECT_ADD_BIN_MD5}")
      message(AUTHOR_WARNING "U3_GVXX_PROJECT_ADD_BIN_URL=${U3_GVXX_PROJECT_ADD_BIN_URL}")
      message(FATAL_ERROR "${U3_MARK_DEV}U3_DBG_STOP_BEFORE_COMPILE_EXTLIBS=${U3_DBG_STOP_BEFORE_COMPILE_EXTLIBS}")
    endif ()
  endif ()

  set(U3_FUNC_RESULT ${U3_FUNC_RESULT} PARENT_SCOPE)
  set(U3_GVXX_PROJECT_ADD_SOURCE_TYPE ${U3_GVXX_PROJECT_ADD_SOURCE_TYPE} PARENT_SCOPE)
endfunction(u3_project_add)
