include("./build/cmake/funcs/u3-url-validate-func.cmake")

macro(u3_project_add_cmake)
  set(U3_FUNC_RESULT FALSE)

  if (NOT U3_FORCE_USE_EXTURL_3RDLIBS)
    u3_validate_url(URL ${U3_GVXX_PROJECT_ADD_ESRC_URL})
    if (NOT U3_FUNC_RESULT)
      message(AUTHOR_ERROR "U3_GVXX_PROJECT_ADD_SRC_URL=${U3_GVXX_PROJECT_ADD_SRC_URL} U3_FUNC_RESULT=${U3_FUNC_RESULT}")
    endif ()

    if (U3_FUNC_RESULT)
      if (NOT U3_GVXX_PROJECT_ADD_USE_HTTP_FOR_ESRC AND NOT ${U3_GVXX_PROJECT_ADD_PROJECT_VERSION} STREQUAL "")
        message(NOTICE "U3_GVXX_PROJECT_ADD_PATCH_CMD=${U3_GVXX_PROJECT_ADD_PATCH_CMD}")
        set(U3_GVXX_PROJECT_ADD_PATCH_CMD_WITH_GIT_SWITCH "${GIT_EXECUTABLE};switch;--detach;${U3_GVXX_PROJECT_ADD_PROJECT_VERSION}")
        if (NOT "${U3_GVXX_PROJECT_ADD_PATCH_CMD}" STREQUAL "")
          set(U3_GVXX_PROJECT_ADD_PATCH_CMD_WITH_GIT_SWITCH "${U3_GVXX_PROJECT_ADD_PATCH_CMD_WITH_GIT_SWITCH};&&" ${U3_GVXX_PROJECT_ADD_PATCH_CMD})
        endif ()
      else ()
        set(U3_GVXX_PROJECT_ADD_PATCH_CMD_WITH_GIT_SWITCH ${U3_GVXX_PROJECT_ADD_PATCH_CMD})
      endif ()

      #message(FATAL_ERROR "U3_GVXX_PROJECT_ADD_PATCH_CMD=${U3_GVXX_PROJECT_ADD_PATCH_CMD}")
      #message(FATAL_ERROR "U3_GVXX_PROJECT_ADD_PATCH_CMD_WITH_GIT_SWITCH=${U3_GVXX_PROJECT_ADD_PATCH_CMD_WITH_GIT_SWITCH}")
      #message(FATAL_ERROR "U3_GVXX_PROJECT_ADD_SRC_URL=${U3_GVXX_PROJECT_ADD_SRC_URL}")
      ExternalProject_Add(
          ${U3_GVXX_PROJECT_ADD_PROJECT_NAME}
          URL ${U3_GVXX_PROJECT_ADD_ESRC_URL}
          PREFIX ${U3_ENV_GEN_3RDLIB_FOLDERS}/${U3_GVXX_PROJECT_ADD_PROJECT_NAME}
          DOWNLOAD_DIR ${U3_ENV_GEN_3RDLIB_FOLDERS_DOWNLOADS}
          DOWNLOAD_NO_PROGRESS TRUE
          URL_HASH MD5=${U3_GVXX_PROJECT_ADD_SRC_MD5}
          DOWNLOAD_EXTRACT_TIMESTAMP FALSE
          TIMEOUT 1200
          PATCH_COMMAND ${U3_GVXX_PROJECT_ADD_PATCH_CMD_WITH_GIT_SWITCH}
          #CONFIGURE_COMMAND           "git switch --detach " ${U3_GVXX_PROJECT_ADD_PROJECT_VERSION}
          BUILD_COMMAND ${CMAKE_COMMAND} --build . --config ${CMAKE_BUILD_TYPE}
          BUILD_IN_SOURCE ${U3_GVXX_PROJECT_ADD_BUILD_IN_SOURCE}
          BUILD_ALWAYS FALSE
          INSTALL_COMMAND ""
          CMAKE_ARGS -DCMAKE_BUILD_TYPE:STRING=${CMAKE_BUILD_TYPE}
          -DCMAKE_SYSTEM_NAME:STRING=${CMAKE_SYSTEM_NAME}
          -DENABLE_SHARED=FALSE
          -DCMAKE_POSITION_INDEPENDENT_CODE=${CMAKE_POSITION_INDEPENDENT_CODE}
          -DCMAKE_SYSTEM_PROCESSOR:STRING=${CMAKE_SYSTEM_PROCESSOR}
          -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
          -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
          -DCMAKE_ASM_COMPILER=${CMAKE_ASM_COMPILER}
          -DCMAKE_TOOLCHAIN_FILE:FILEPATH=${CMAKE_TOOLCHAIN_FILE}
          -DCMAKE_POLICY_DEFAULT_CMP0057:STRING=NEW
          -DCMAKE_POLICY_VERSION_MINIMUM=3.10
          ${U3_SHARED_COMPILE_DEF_CPP}
          ${U3_GVXX_PROJECT_ADD_EXT_CMAKE_ARGS}
      )

      set(U3_GVXX_PROJECT_ADD_SOURCE_TYPE "U3_ADD_PROJECT_RESULT_SRC")
    endif ()
  endif ()

  if (NOT U3_FUNC_RESULT AND NOT U3_FORCE_USE_LOCURL_3RDLIBS)
    if (U3_GVXX_PROJECT_ADD_USE_HTTP_FOR_ESRC)
      ExternalProject_Add(
          ${U3_GVXX_PROJECT_ADD_PROJECT_NAME}
          URL ${U3_GVXX_PROJECT_ADD_SRC_URL}
          PREFIX ${U3_ENV_GEN_3RDLIB_FOLDERS}/${U3_GVXX_PROJECT_ADD_PROJECT_NAME}
          DOWNLOAD_DIR ${U3_ENV_GEN_3RDLIB_FOLDERS_DOWNLOADS}
          DOWNLOAD_NO_PROGRESS TRUE
          URL_HASH MD5=${U3_GVXX_PROJECT_ADD_ESRC_MD5}
          DOWNLOAD_EXTRACT_TIMESTAMP FALSE
          TIMEOUT 1200
          PATCH_COMMAND ${U3_GVXX_PROJECT_ADD_PATCH_CMD}
          #CONFIGURE_COMMAND           "git switch --detach " ${U3_GVXX_PROJECT_ADD_PROJECT_VERSION}
          BUILD_COMMAND ${CMAKE_COMMAND} --build . --config ${CMAKE_BUILD_TYPE}
          BUILD_IN_SOURCE ${U3_GVXX_PROJECT_ADD_BUILD_IN_SOURCE}
          BUILD_ALWAYS FALSE
          INSTALL_COMMAND ""
          CMAKE_ARGS -DCMAKE_BUILD_TYPE:STRING=${CMAKE_BUILD_TYPE}
          -DCMAKE_SYSTEM_NAME:STRING=${CMAKE_SYSTEM_NAME}
          -DENABLE_SHARED=FALSE
          -DCMAKE_POSITION_INDEPENDENT_CODE=${CMAKE_POSITION_INDEPENDENT_CODE}
          -DCMAKE_SYSTEM_PROCESSOR:STRING=${CMAKE_SYSTEM_PROCESSOR}
          -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
          -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
          -DCMAKE_ASM_COMPILER=${CMAKE_ASM_COMPILER}
          -DCMAKE_TOOLCHAIN_FILE:FILEPATH=${CMAKE_TOOLCHAIN_FILE}
          -DCMAKE_POLICY_DEFAULT_CMP0057:STRING=NEW
          -DCMAKE_POLICY_VERSION_MINIMUM=3.10
          ${U3_SHARED_COMPILE_DEF_CPP}
          ${U3_GVXX_PROJECT_ADD_EXT_CMAKE_ARGS}
      )

      set(U3_GVXX_PROJECT_ADD_SOURCE_TYPE "U3_ADD_PROJECT_RESULT_SRC_EXT_URL")
    else ()
      ExternalProject_Add(
          ${U3_GVXX_PROJECT_ADD_PROJECT_NAME}
          GIT_REPOSITORY ${U3_GVXX_PROJECT_ADD_SRC_URL}
          GIT_TAG ${U3_GVXX_PROJECT_ADD_PROJECT_VERSION}
          GIT_PROGRESS FALSE
          PREFIX ${U3_ENV_GEN_3RDLIB_FOLDERS}/${U3_GVXX_PROJECT_ADD_PROJECT_NAME}
          DOWNLOAD_EXTRACT_TIMESTAMP FALSE
          TIMEOUT 1200
          PATCH_COMMAND ${U3_GVXX_PROJECT_ADD_PATCH_CMD}
          #CONFIGURE_COMMAND           ""
          BUILD_COMMAND ${CMAKE_COMMAND} --build . --config ${CMAKE_BUILD_TYPE}
          BUILD_IN_SOURCE ${U3_GVXX_PROJECT_ADD_BUILD_IN_SOURCE}
          BUILD_ALWAYS FALSE
          INSTALL_COMMAND ""
          CMAKE_ARGS -DCMAKE_BUILD_TYPE:STRING=${CMAKE_BUILD_TYPE}
          -DCMAKE_SYSTEM_NAME:STRING=${CMAKE_SYSTEM_NAME}
          -DENABLE_SHARED=FALSE
          -DCMAKE_POSITION_INDEPENDENT_CODE=${CMAKE_POSITION_INDEPENDENT_CODE}
          -DCMAKE_SYSTEM_PROCESSOR:STRING=${CMAKE_SYSTEM_PROCESSOR}
          -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
          -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
          -DCMAKE_ASM_COMPILER=${CMAKE_ASM_COMPILER}
          -DCMAKE_TOOLCHAIN_FILE:FILEPATH=${CMAKE_TOOLCHAIN_FILE}
          -DCMAKE_POLICY_DEFAULT_CMP0057:STRING=NEW
          -DCMAKE_POLICY_VERSION_MINIMUM=3.10
          ${U3_SHARED_COMPILE_DEF_CPP}
          ${U3_GVXX_PROJECT_ADD_EXT_CMAKE_ARGS}
      )

      set(U3_GVXX_PROJECT_ADD_SOURCE_TYPE "U3_ADD_PROJECT_RESULT_SRC_EXT_GIT")
    endif ()
  endif ()
endmacro(u3_project_add_cmake)

