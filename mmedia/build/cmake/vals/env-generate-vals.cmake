cmake_host_system_information(RESULT U3_OS_NAME QUERY OS_NAME)
cmake_host_system_information(RESULT U3_OS_RELEASE QUERY OS_RELEASE)
cmake_host_system_information(RESULT U3_OS_VERSION QUERY OS_VERSION)
cmake_host_system_information(RESULT U3_OS_OS_PLATFORM QUERY OS_PLATFORM)

u3_get_major_version(CMAKE_CXX_COMPILER_VERSION U3_CMAKE_CXX_COMPILER_VERSION_CID)
u3_get_major_version(CMAKE_C_COMPILER_VERSION U3_CMAKE_C_COMPILER_VERSION_CID)

if (NOT U3_CMAKE_CXX_COMPILER_VERSION_CID OR
    NOT U3_CMAKE_C_COMPILER_VERSION_CID)
  message(FATAL_ERROR "not found U3_CMAKE_CXX_COMPILER_VERSION_CID=${U3_CMAKE_CXX_COMPILER_VERSION_CID} or U3_CMAKE_C_COMPILER_VERSION_CID=${U3_CMAKE_C_COMPILER_VERSION_CID}")
endif ()

set(U3_ENV_GEN_CPP_COMPILER_ID "${CMAKE_CXX_COMPILER_ID}-${U3_CMAKE_CXX_COMPILER_VERSION_CID}")
set(U3_ENV_GEN_C_COMPILER_ID "${CMAKE_C_COMPILER_ID}-${U3_CMAKE_C_COMPILER_VERSION_CID}")
set(U3_ENV_GEN_ASM_COMPILER_ID "${CMAKE_ASM_COMPILER_ID}")
set(U3_ENV_GEN_COMPILERS_ID "${U3_ENV_GEN_CPP_COMPILER_ID}-${U3_ENV_GEN_C_COMPILER_ID}-${U3_ENV_GEN_ASM_COMPILER_ID}")
#set(U3_ENV_GEN_COMPILERS_ID "${CMAKE_CXX_COMPILER_ID}-${U3_CMAKE_CXX_COMPILER_VERSION_CID}-${CMAKE_C_COMPILER_ID}-${U3_CMAKE_C_COMPILER_VERSION_CID}-${CMAKE_ASM_COMPILER_ID}")
set(U3_ENV_GEN_RAW_3RDLIB_POSTFIX "${U3_PLATFORM_NAME}-${U3_ENV_GEN_COMPILERS_ID}-${CMAKE_SYSTEM_PROCESSOR}-${CMAKE_BUILD_TYPE}-${U3_SANITY_TYPE}")
set(U3_ENV_GEN_3RDLIB_FOLDERS "./../u3builds-extlibs-${U3_ENV_GEN_RAW_3RDLIB_POSTFIX}-${CMAKE_GENERATOR}")

string(REPLACE "-" "_" U3_ENV_GEN_3RDLIB_POSTFIX ${U3_ENV_GEN_RAW_3RDLIB_POSTFIX})

string(TOLOWER ${CMAKE_BUILD_TYPE} U3_ENV_CMAKE_BUILD_TYPE_LC)
string(TOUPPER ${CMAKE_BUILD_TYPE} U3_ENV_CMAKE_BUILD_TYPE_UC)
string(TIMESTAMP U3_TIME_START_BUILD "%Y-%m-%d:%H.%m.%S.%f")

math(EXPR U3_ENV_PTR_BITS_COUNT "${CMAKE_SIZEOF_VOID_P} * 8")

set(U3_X64_CPU_LIST x64 x86_64)
set(U3_ARM_CPU_LIST aarch64 arm)
set(U3_MIPS_CPU_LIST mips)
set(U3_RISCV_CPU_LIST riscv)

if ((CMAKE_SYSTEM_PROCESSOR IN_LIST U3_X64_CPU_LIST AND NOT CMAKE_HOST_SYSTEM_PROCESSOR IN_LIST U3_X64_CPU_LIST) OR
(CMAKE_SYSTEM_PROCESSOR IN_LIST U3_ARM_CPU_LIST AND NOT CMAKE_HOST_SYSTEM_PROCESSOR IN_LIST U3_ARM_CPU_LIST))
  set(U3_DETECT_CROSS_COMPILE TRUE)
  #set(U3_DLIB_SKIP_COMPILE TRUE)
else ()
  set(U3_DETECT_CROSS_COMPILE FALSE)
endif ()

message(NOTICE "****** BEGIN DUMP GENERATE VARIABLES")
message(NOTICE "*** U3_ENV_GEN_3RDLIB_FOLDERS=${U3_ENV_GEN_3RDLIB_FOLDERS}")
message(NOTICE "*** U3_ENV_GEN_RAW_3RDLIB_POSTFIX=${U3_ENV_GEN_RAW_3RDLIB_POSTFIX}")
message(NOTICE "*** U3_ENV_GEN_3RDLIB_POSTFIX=${U3_ENV_GEN_3RDLIB_POSTFIX}")
message(NOTICE "*** U3_ENV_CMAKE_BUILD_TYPE_LC=${U3_ENV_CMAKE_BUILD_TYPE_LC}")
message(NOTICE "*** U3_ENV_CMAKE_BUILD_TYPE_UC=${U3_ENV_CMAKE_BUILD_TYPE_UC}")
message(NOTICE "*** U3_ENV_PTR_BITS_COUNT=${U3_ENV_PTR_BITS_COUNT}")
message(NOTICE "****** END DUMP GENERATE VARIABLES")
