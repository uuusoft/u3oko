include("./.ci/cmake/3rdlibs/sqlitecpp/u3-sqlitecpp-lib-values.cmake")

set(U3_3RDLIB_NAME_SQLITECPP_UTIL ${U3_3RDLIB_NAME_SQLITECPP}-util)

u3_project_add(
    PROJECT_NAME ${U3_3RDLIB_NAME_SQLITECPP_UTIL}
    PROJECT_VERSION ${U3_3RDLIB_VER_SQLITECPP}
    BIN_URL ${U3_3RDLIB_ESRC_URL_SQLITECPP_BIN}
    NAME_BIN_MD5 U3_3RDLIB_SQLITECPP${U3_3RDLIB_VER_SQLITECPP_CID}_MD5_${U3_GENV_3RDLIB_POSTFIX}
    BIN_MD5 ${U3_3RDLIB_SQLITECPP${U3_3RDLIB_VER_SQLITECPP_CID}_MD5_${U3_GENV_3RDLIB_POSTFIX}}
    SRC_URL ${U3_3RDLIB_OSRC_URL_SQLITECPP}
    SRC_MD5 ${U3_3RDLIB_SQLITECPP_MD5}
    ESRC_URL ${U3_3RDLIB_ESRC_URL_SQLITECPP_SRC}
    ESRC_MD5 ${U3_3RDLIB_SQLITECPP_MD5}
    PATCH_CMD ""
    INSTALL_COMMAND "echo"
    USE_HTTP_FOR_ESRC FALSE
    BUILD_IN_SOURCE FALSE
    IT_CMAKE_PROJECT TRUE
    FORCE_COMPILE FALSE
    EXT_CMAKE_ARGS "")

ExternalProject_Get_Property(${U3_3RDLIB_NAME_SQLITECPP_UTIL} install_dir)

set(U3_INCLUDE_DIR_EXTLIB_SQLITECPP ${install_dir}/src/sqlitecpp-util/include)
set(U3_INSTALL_DIR_EXTLIB_SQLITECPP "${install_dir}/src/sqlitecpp-util/${U3_ADD2PATH_EXTLIB_SQLITE}${U3_PREFIX_LIB_NAME}SQLiteCpp.${U3_SUFFIX_LIB_NAME}")

if (NOT U3_GVXX_SOURCE_TYPE STREQUAL "U3_ADD_PROJECT_RESULT_BIN")

  if (U3_PLATFORM_NAME STREQUAL U3_PLATFORM_NAME_WINDOWS OR
      CMAKE_GENERATOR STREQUAL "Xcode")
    set(U3_ADD2PATH_EXTLIB_SQLITECPP "${CMAKE_BUILD_TYPE}/")
  else ()
    set(U3_ADD2PATH_EXTLIB_SQLITECPP "")
  endif ()

  set(U3_INSTALL_DIR_EXTLIB_SQLITECPP "${install_dir}/src/sqlitecpp-util-build/${U3_ADD2PATH_EXTLIB_SQLITECPP}${U3_PREFIX_LIB_NAME}SQLiteCpp.${U3_SUFFIX_LIB_NAME}")
  set(U3_BIN_TEMP_FOLDER_EXTLIB_SQLITECPP "${install_dir}/~temp-sqlitecpp-util")

  add_custom_command(
      TARGET ${U3_3RDLIB_NAME_SQLITECPP_UTIL}
      POST_BUILD
      COMMAND
      ${CMAKE_COMMAND} -E rm -Rf "${U3_BIN_TEMP_FOLDER_EXTLIB_SQLITECPP}"
      COMMAND
      ${CMAKE_COMMAND} -E make_directory "${U3_BIN_TEMP_FOLDER_EXTLIB_SQLITECPP}"
      COMMAND
      ${CMAKE_COMMAND} -E make_directory "${U3_BIN_TEMP_FOLDER_EXTLIB_SQLITECPP}/include/SQLiteCpp/"
      COMMAND
      ${CMAKE_COMMAND} -E copy "${install_dir}/src/sqlitecpp-util-build/*.a" "${U3_BIN_TEMP_FOLDER_EXTLIB_SQLITECPP}"
      COMMAND
      ${CMAKE_COMMAND} -E copy "${install_dir}/src/sqlitecpp-util/include/SQLiteCpp/*.h" "${U3_BIN_TEMP_FOLDER_EXTLIB_SQLITECPP}/include/SQLiteCpp/"
      COMMAND
      ${CMAKE_COMMAND} -E chdir "${U3_BIN_TEMP_FOLDER_EXTLIB_SQLITECPP}" tar czvf "${install_dir}/../${U3_3RDLIB_NAME_SQLITECPP_BIN}" "./")

endif ()

u3_make_fake_file(FILE_NAME ${U3_INSTALL_DIR_EXTLIB_SQLITECPP} CONTENT "sqlitecpp")

add_library(u3-sqlitecpp-lib STATIC IMPORTED)
set_target_properties(u3-sqlitecpp-lib PROPERTIES IMPORTED_LOCATION ${U3_INSTALL_DIR_EXTLIB_SQLITECPP})
add_dependencies(u3-sqlitecpp-lib ${U3_3RDLIB_NAME_SQLITECPP_UTIL})

set(U3_DEPENDENCY_TARGETS_LIST ${U3_DEPENDENCY_TARGETS_LIST} ${U3_3RDLIB_NAME_SQLITECPP_UTIL})
set(U3_SELECTED_3RDLIBS_LIST ${U3_SELECTED_3RDLIBS_LIST} u3-sqlitecpp-lib)
